# Local dev: supabase functions serve --env-file supabase/functions/.env --no-verify-jwt
# Production: supabase secrets set QR_SIGNING_SECRET=... PWA_BASE_URL=... PWA_ORIGIN=...
QR_SIGNING_SECRET=generate-with-openssl-rand-hex-32
PWA_BASE_URL=http://localhost:3000
PWA_ORIGIN=http://localhost:3000
# optional: MAX_ORDER_PAISE=2500000
# M3 push notifications
WEBHOOK_SECRET=generate-with-openssl-rand-hex-24
# FCM_SERVICE_ACCOUNT_JSON: paste the whole service-account JSON from Firebase on one line (production: supabase secrets set)
FCM_SERVICE_ACCOUNT_JSON=
