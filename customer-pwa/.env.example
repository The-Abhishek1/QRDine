# Edge Functions base URL of your Supabase project (no trailing slash).
NEXT_PUBLIC_API_BASE=https://YOUR-PROJECT-REF.supabase.co/functions/v1
# Required for customer account sign-in. This is the public anon key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
